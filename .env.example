
PORT=5000

NODE_ENV="development"

MONGODB_URI="mongodb://127.0.0.1:27017/albaraka"

CORS_ORIGIN="http://localhost:3000"

JWT_SECRET="replace-with-a-long-random-secret"

# Required only when running `npm run seed:superadmin` to create the first admin.
SUPERADMIN_NAME="Store Owner"
SUPERADMIN_EMAIL="admin@example.com"
SUPERADMIN_PASSWORD="replace-with-a-password-of-at-least-8-characters"

JWT_EXPIRES_IN="30d"

IMAGEKIT_PUBLIC_KEY="your_public_key"
IMAGEKIT_PRIVATE_KEY="your_private_key"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"

# Optional: enables browser push notifications for order updates.
# Generate a matching public/private key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID contact identifier, usually a mailto: address you can be reached at.
VAPID_SUBJECT="mailto:admin@example.com"